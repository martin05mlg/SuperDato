# ==============================================================================
# SuperDato — Plantilla de Configuración de Entorno (.env)
# ==============================================================================

# --- Parámetros de la Aplicación ---
APP_NAME=SuperDato
APP_VERSION=0.1.0
ENVIRONMENT=production
DEBUG=false

# --- Servidor y Acceso Web ---
# URL pública con la que accedes a SuperDato desde tu navegador o dominio local/remoto
SERVER_PUBLIC_URL=http://localhost:5173

# --- Credenciales Iniciales del Superadministrador ---
# Al desplegar con la base de datos limpia, se creará automáticamente este usuario
# con privilegios de superadministrador para acceder al panel de control en /admin
SUPERADMIN_EMAIL=admin@superdato.com
SUPERADMIN_PASSWORD=SuperDatoAdmin2026!

# --- Seguridad y Criptografía (Mínimo 32 caracteres) ---
# Genera claves seguras para producción (ej. con openssl rand -hex 32)
SECRET_KEY=generate_a_secure_random_key_here_min_32_chars_1234567890abcdef
ENCRYPTION_MASTER_KEY=01234567890123456789012345678901

# --- Base de Datos PostgreSQL 16 ---
POSTGRES_USER=superdato
POSTGRES_PASSWORD=superdato_secret_password
POSTGRES_DB=superdato_db
POSTGRES_PORT=5432

# --- Redis 7 & Celery ---
REDIS_PORT=6379

# --- Datos de Muestra Iniciales ---
# Genera automáticamente tickets de muestra en el primer arranque para explorar los gráficos
AUTO_SEED_SAMPLES=true

# --- Google OAuth 2.0 (Opcional) ---
# Puedes dejarlas vacías aquí y configurarlas cómodamente desde la interfaz web
# en el Panel de Superadministración -> "Google OAuth & Servidor"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/integrations/google/callback
