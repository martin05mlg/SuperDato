# SuperDato - Environment Variables Example Configuration

# Application
APP_NAME=SuperDato
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# Security
SECRET_KEY=generate_a_secure_random_key_here_min_32_chars
ENCRYPTION_MASTER_KEY=01234567890123456789012345678901

# PostgreSQL Database
POSTGRES_USER=superdato
POSTGRES_PASSWORD=superdato_secret_password
POSTGRES_DB=superdato_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://superdato:superdato_secret_password@localhost:5432/superdato_db

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Google OAuth 2.0 (Testing Mode)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173/integrations/google/callback

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

