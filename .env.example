# ==============================================================================
# SuperDato — Plantilla de Configuración de Entorno (.env)
# ==============================================================================
# NOTA: Este archivo es OPCIONAL. Con `docker compose up -d`, SuperDato genera y
# persiste automáticamente SECRET_KEY, ENCRYPTION_MASTER_KEY y una contraseña
# aleatoria única para el Superadministrador en el primer arranque.

# --- Parámetros de la Aplicación ---
APP_NAME=SuperDato
APP_VERSION=0.1.0
ENVIRONMENT=production
DEBUG=false
ENABLE_DOCS=false
RATE_LIMIT_ENABLED=true
AUTO_MIGRATE=true
ENABLE_MERCADONA_ONLINE=false

# --- Servidor y Acceso Web ---
# URL pública con la que accedes a SuperDato desde tu navegador o dominio (también editable desde /admin)
SERVER_PUBLIC_URL=http://localhost:5173
# Orígenes CORS adicionales separados por comas (opcional)
CORS_EXTRA_ORIGINS=

# --- Credenciales Iniciales del Superadministrador (Opcional) ---
# Si dejas SUPERADMIN_PASSWORD vacío (recomendado), SuperDato activará el
# First-Run Web Setup Wizard para que configures tu cuenta cómodamente desde el navegador.
# Si prefieres despliegues desatendidos (CI/CD), puedes rellenarlas aquí.
SUPERADMIN_EMAIL=admin@superdato.com
SUPERADMIN_PASSWORD=

# --- Seguridad y Criptografía (Mínimo 32 caracteres) ---
# Si las dejas vacías, se generan automáticamente y se guardan en `/app/data/.secrets.json` (permisos 0600).
SECRET_KEY=
ENCRYPTION_MASTER_KEY=

# --- Base de Datos PostgreSQL 16 ---
POSTGRES_USER=superdato
POSTGRES_PASSWORD=superdato_secret_password
POSTGRES_DB=superdato_db
POSTGRES_PORT=5432

# --- Redis 7 & Celery ---
REDIS_PORT=6379
API_PORT=8000

# --- Datos de Muestra Iniciales ---
# Genera automáticamente tickets sintéticos de muestra en el primer arranque (borrables desde /admin)
AUTO_SEED_SAMPLES=true

# --- Google OAuth 2.0 (Opcional) ---
# Puedes dejarlas vacías aquí y configurarlas desde la web en Panel de Administración -> "Google OAuth & Servidor"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/integrations/google/callback
